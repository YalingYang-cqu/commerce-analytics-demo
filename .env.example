# 本地作品集 Demo：复制为 .env.development 后即可 pnpm dev
# 所有业务请求由前端 Mock 处理，不要填写真实服务地址或密钥

VITE_VERSION = 1.0.0-demo
VITE_PORT = 7083
VITE_BASE_URL = /charts/
VITE_API_URL = /api
VITE_ACCESS_MODE = frontend
VITE_HOME_PAGE_PATH = /purchase/batch-cost
VITE_WITH_CREDENTIALS = false
VITE_OPEN_ROUTE_INFO = false
VITE_LOCK_ENCRYPT_KEY = local-demo-only
VITE_USE_MOCK = true
VITE_DROP_CONSOLE = false
VITE_FLAG = demo
VITE_ENV_CHN = "(本地演示)"
